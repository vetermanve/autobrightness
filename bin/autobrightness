#!/bin/bash
# autobrightness - match external monitors to room light on macOS.
#
# Ambient light is resolved through a chain of sources, highest priority first:
#
#   manual  - a level set by hand, from the menu bar app or `autobrightness manual`.
#             An instruction, so it outranks every sensor until cleared.
#   sensor  - AMBIENT_CMD, an external meter printing nits. Nothing ships with it;
#             see docs/ideas.md for what to plug in.
#   als     - the built-in display's own luminance. With auto-brightness enabled it
#             already tracks the ambient sensor, and reading it costs ~9 ms.
#   solar   - a model of this machine's own als history against the sun's elevation,
#             used when the panel is off: lid shut, or displays asleep.
#   hold    - the last trusted als reading, when the model has nothing for this hour.
#
# The built-in panel is the only real sensor here, and it is dark exactly when the
# lid is shut - the ambient sensor sits in the lid and faces the keyboard. So a
# closed lid leaves the Mac with no measurement at all, and what the solar source
# replays is this machine's own measured history, not an invented curve.
#
# This is NOT True Tone. Apple measures the room's colour TEMPERATURE with a
# multi-channel sensor and does not expose that data. This uses ambient LEVEL only:
# brighter room -> brighter and more neutral, darker room -> dimmer and warmer.
set -u
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
# awk prints a decimal comma under a ru/de/fr locale, and every later comparison
# then reads the number as zero. Not cosmetic: nits are fractional.
export LC_ALL=C

# ---- defaults; override in ~/.config/autobrightness/config ----
# Monitors: "name:lum_min:lum_max:blue_min:blue_max[:mode]"
# Empty blue fields mean the monitor has no RGB gain control - brightness only.
# The name must match what `m1ddc display list` prints.
DISPLAYS=(
  "CR270ST:15:90:38:50"
  "HP P24h G4:10:85::"
  # Panels that do not answer DDC can be dimmed in software instead - see README
  # for what that costs. Sixth field "gamma" selects it.
  # "DELL E2420HS:25:100:::gamma"
)
B_LO=0.05;  B_HI=0.95      # built-in slider anchor points, used when MATCH=slider

# How the external target is derived from the ambient reading.
#   nits   - match absolute luminance. The built-in slider is badly nonlinear:
#            slider 0.10 is about 1.5 nits while 1.00 is about 400, so matching
#            by slider percentage leaves externals ~30x too bright in the dark.
#   slider - the old linear map between the anchor points above. Only the als
#            source has a slider position, so this falls back to nits whenever
#            the built-in panel is off.
MATCH=nits
# Display gamma, used only by software-dimmed panels. The gamma table scales the
# encoded signal, so the multiplier has to be the 1/GAMMA power of the luminance
# ratio you want. 2.2 is the sRGB figure; calibrate by eye if a panel disagrees.
PANEL_GAMMA=2.2
# Panel peak luminance in nits, needed to convert. Check the spec sheet, or read
# the declared value with display-check.
DISPLAY_NITS=(
  "CR270ST:300"
  "HP P24h G4:250"
  "DELL E2420HS:250"
)
HYST_LUM=2; HYST_BLUE=2    # ignore smaller drifts
INTERVAL=5                 # agent poll period, seconds
RESYNC_EVERY=2             # every N ticks re-read monitors (catches OSD edits)
RAMP_DIRECT=4              # deltas up to this are written in one go, no ramp
RAMP_MAX_STEPS=80          # step budget cap; one DDC write costs about 63 ms
RAMP_CHUNK=8               # units of travel between ambient re-checks mid-ramp

# ---- ambient sources ----
# Coordinates for the solar model. Without them the model is off entirely and a
# closed lid falls through to hold. Degrees, north and east positive.
SOLAR_LAT=""; SOLAR_LON=""
# A command printing one ambient value in nits on stdout. Empty means no meter.
AMBIENT_CMD=""
# macOS restores the pre-sleep brightness when a panel wakes and auto-brightness
# corrects it only a moment later, so readings taken right after the panel comes
# back describe the room it went to sleep in. Hold for this long instead.
WAKE_SETTLE=10
SAMPLE_EVERY=60            # seconds between samples fed to the solar model
MODEL_BIN_DEG=5            # sun elevation bucket width, degrees
MODEL_MEAN_OVER=50         # samples averaged per bucket before it becomes an EWMA
MODEL_FORGET_DAYS=30       # a bucket older than this is replaced, not blended
MODEL_SPAN=3               # buckets searched either side when one has no data
HOLD_MAX_AGE=0             # 0 = hold the last reading forever; else give up after N s
# -------------------------------------------------------------

CONFIG="${AUTOBRIGHTNESS_CONFIG:-$HOME/.config/autobrightness/config}"
# shellcheck source=/dev/null
[ -f "$CONFIG" ] && . "$CONFIG"

# Both paths are overridable so the test suite can run against its own state
# directory and a stub brightness reader, without racing the live agent.
STATE_DIR="${AUTOBRIGHTNESS_STATE:-$HOME/.local/state}"
PAUSE_FILE="$STATE_DIR/autobrightness.paused"
SEEN_FILE="$STATE_DIR/autobrightness.settings-seen"
TICK_FILE="$STATE_DIR/autobrightness.tick"
LOG_FILE="$STATE_DIR/autobrightness.log"
AMBIENT_FILE="$STATE_DIR/autobrightness.ambient"    # resolved value, read by softdim
LIVE_FILE="$STATE_DIR/autobrightness.live"          # last trusted als reading
PHASE_FILE="$STATE_DIR/autobrightness.phase"        # als|off and since when
MANUAL_FILE="$STATE_DIR/autobrightness.manual"      # hand-set level
MODEL_FILE="$STATE_DIR/autobrightness.solar"        # the learned curve
SAMPLE_FILE="$STATE_DIR/autobrightness.sample"      # when the model last took a sample
MAP_FILE="$STATE_DIR/autobrightness.displays"       # uuid -> name, read by softdim
BB="${AUTOBRIGHTNESS_BB:-$HOME/.local/libexec/autobrightness-builtin-brightness}"
PLIST="$HOME/Library/LaunchAgents/local.autobrightness.plist"
GPLIST="$HOME/Library/LaunchAgents/local.autobrightness-gamma.plist"
SOFTDIM="$HOME/.local/libexec/autobrightness-softdim"
CONTRACT=1   # shape of --indicator; raise it together with the menu bar app

die() { echo "$1" >&2; exit 1; }
interp() { awk -v x="$1" -v xl="$2" -v xh="$3" -v yl="$4" -v yh="$5" \
    'BEGIN{ t=(x-xl)/(xh-xl); if(t<0)t=0; if(t>1)t=1; printf "%d", yl+t*(yh-yl) }'; }
absdiff() { awk -v a="${1:-0}" -v b="${2:-0}" 'BEGIN{d=a-b; if(d<0)d=-d; print d}'; }
slug() { echo "$1" | tr -c 'A-Za-z0-9' '_'; }
logline() {
    mkdir -p "$STATE_DIR"
    echo "$(date '+%H:%M:%S') $*" >> "$LOG_FILE"
    tail -300 "$LOG_FILE" > "$LOG_FILE.tmp" 2>/dev/null && mv "$LOG_FILE.tmp" "$LOG_FILE"
}
find_display() { m1ddc display list 2>/dev/null | grep -F "$1" | sed -n 's/^\[\([0-9]*\)\].*/\1/p' | head -1; }
max_nits() { # name -> panel peak luminance, empty when unknown
    local e
    for e in "${DISPLAY_NITS[@]}"; do
        case "$e" in "$1:"*) echo "${e##*:}"; return;; esac
    done
}
isnum() { awk -v v="${1:-}" 'BEGIN{ exit !(v ~ /^[0-9]+(\.[0-9]+)?$/) }'; }

# ---- solar position ----------------------------------------------------------
# Low-precision NOAA formulas: about 0.01 deg, which is three orders of magnitude
# finer than a 5 deg bucket. Verified against the equinox day length at three
# latitudes, the solstice noon elevation at the equator, and polar night.
sun_elev() { # epoch -> degrees above the horizon
    awk -v t="$1" -v lat="$SOLAR_LAT" -v lon="$SOLAR_LON" 'BEGIN{
        pi = atan2(0, -1); d2r = pi / 180
        n = t / 86400.0 + 2440587.5 - 2451545.0      # days since J2000
        L = (280.460 + 0.9856474 * n) % 360          # mean longitude
        g = (357.528 + 0.9856003 * n) % 360          # mean anomaly
        lam = L + 1.915 * sin(g * d2r) + 0.020 * sin(2 * g * d2r)
        eps = 23.439 - 0.0000004 * n
        sl = sin(lam * d2r); cl = cos(lam * d2r)
        sd = sin(eps * d2r) * sl
        dec = atan2(sd, sqrt(1 - sd * sd))
        ra = atan2(cos(eps * d2r) * sl, cl) / d2r
        gmst = (18.697374558 + 24.06570982441908 * n) % 24
        if (gmst < 0) gmst += 24
        H = gmst * 15 + lon - ra                     # hour angle
        H = H - 360 * int(H / 360)
        if (H > 180) H -= 360; if (H < -180) H += 360
        sh = sin(lat * d2r) * sin(dec) + cos(lat * d2r) * cos(dec) * cos(H * d2r)
        printf "%.2f", atan2(sh, sqrt(1 - sh * sh)) / d2r
    }'
}
solar_on() { [ -n "$SOLAR_LAT" ] && [ -n "$SOLAR_LON" ]; }
model_bin() { # elevation -> bucket index
    awk -v e="$1" -v w="$MODEL_BIN_DEG" 'BEGIN{
        last = int(180 / w) - 1
        b = int((e + 90) / w); if (b < 0) b = 0; if (b > last) b = last
        print b }'
}

# ---- the solar model --------------------------------------------------------
# One line per elevation bucket: "bucket nits samples updated_epoch".
# The first MODEL_MEAN_OVER samples form a plain running mean, after which the
# bucket becomes an EWMA with that time constant - so a bucket settles on the
# habit across days rather than on whatever the last visit happened to show. A
# bucket untouched for MODEL_FORGET_DAYS is replaced outright: the season moved,
# or the lamps did.
model_sample() { # nits now
    solar_on || return 0
    local last=0
    [ -f "$SAMPLE_FILE" ] && read -r last < "$SAMPLE_FILE" 2>/dev/null
    isnum "${last:-}" || last=0
    [ $(( $2 - ${last%.*} )) -ge "$SAMPLE_EVERY" ] || return 0
    echo "$2" > "$SAMPLE_FILE"

    local bin; bin=$(model_bin "$(sun_elev "$2")")
    touch "$MODEL_FILE"
    awk -v bin="$bin" -v nits="$1" -v now="$2" -v cap="$MODEL_MEAN_OVER" \
        -v forget="$MODEL_FORGET_DAYS" '
        $1 == bin {
            if (now - $4 > forget * 86400) { print bin, nits, 1, now; done = 1; next }
            n = $3 + 1
            a = 1 / (n < cap ? n : cap)
            printf "%s %.1f %d %d\n", bin, $2 + a * (nits - $2), n, now
            done = 1; next
        }
        { print }
        END { if (!done) printf "%s %.1f %d %d\n", bin, nits, 1, now }
    ' "$MODEL_FILE" > "$MODEL_FILE.tmp" && mv "$MODEL_FILE.tmp" "$MODEL_FILE"
}
model_predict() { # bucket -> nits, or nothing when the model cannot say
    [ -s "$MODEL_FILE" ] || return 1
    awk -v bin="$1" -v span="$MODEL_SPAN" '
        { v[$1 + 0] = $2 }
        END {
            if (bin in v) { printf "%.1f\n", v[bin]; exit 0 }
            lo = -1; hi = -1
            for (d = 1; d <= span; d++) {
                if (lo < 0 && (bin - d) in v) { lo = bin - d; lov = v[lo] }
                if (hi < 0 && (bin + d) in v) { hi = bin + d; hiv = v[hi] }
            }
            # Between two known buckets, interpolate. Past the end of what has
            # been measured, hold the nearest bucket flat rather than run the
            # slope off into numbers nothing supports.
            if (lo >= 0 && hi >= 0) { printf "%.1f\n", lov + (bin - lo) / (hi - lo) * (hiv - lov); exit 0 }
            if (lo >= 0) { printf "%.1f\n", lov; exit 0 }
            if (hi >= 0) { printf "%.1f\n", hiv; exit 0 }
            exit 1
        }' "$MODEL_FILE"
}
model_bins() { # -> "filled total"
    local total; total=$(awk -v w="$MODEL_BIN_DEG" 'BEGIN{ print int(180 / w) }')
    local filled=0
    [ -s "$MODEL_FILE" ] && filled=$(wc -l < "$MODEL_FILE" | tr -d ' ')
    echo "$filled $total"
}

# ---- ambient resolution -----------------------------------------------------
# Sets amb_nits, amb_source, amb_age, amb_slider (als only) and amb_elev.
# Returns non-zero when no source can say anything, in which case nothing is
# applied: the monitors keep whatever they have.
amb_nits=""; amb_source=none; amb_age=0; amb_slider=""; amb_elev=""
resolve_ambient() {
    local now; now=$(date +%s)
    amb_slider=""; amb_age=0; amb_elev=""; amb_nits=""; amb_source=none
    solar_on && amb_elev=$(sun_elev "$now")

    # 1. a hand-set level outranks every sensor - it is an instruction, not a guess
    if [ -f "$MANUAL_FILE" ]; then
        local mn="" me=""
        read -r mn me < "$MANUAL_FILE" 2>/dev/null || true
        if isnum "${mn:-}"; then
            isnum "${me:-}" || me=$now
            amb_nits=$mn; amb_source=manual; amb_age=$(( now - me )); return 0
        fi
    fi

    # 2. an external meter, when one is configured
    if [ -n "$AMBIENT_CMD" ]; then
        local v; v=$(eval "$AMBIENT_CMD" 2>/dev/null | head -1 | tr -d ' \r')
        if isnum "${v:-}" && awk -v v="$v" 'BEGIN{exit !(v > 0)}'; then
            amb_nits=$v; amb_source=sensor; return 0
        fi
    fi

    # 3. the built-in panel. Zero nits is the backlight being off - lid shut, or
    #    displays asleep - which is not a reading of the room at all.
    local s="" n="" cap="" live=0
    if read -r s n cap < <("$BB" --nits 2>/dev/null); then
        isnum "${n:-}" && awk -v n="$n" 'BEGIN{exit !(n > 0)}' && live=1
    fi
    local phase=off since=$now
    if [ -f "$PHASE_FILE" ]; then
        read -r phase since < "$PHASE_FILE" 2>/dev/null || true
        isnum "${since:-}" || since=$now
    fi
    if [ "$live" = 1 ]; then
        if [ "$phase" != "als" ]; then
            phase=als; since=$now
            echo "als $now" > "$PHASE_FILE"
            logline "built-in panel awake, settling ${WAKE_SETTLE}s before trusting it"
        fi
        if [ $(( now - since )) -ge "$WAKE_SETTLE" ]; then
            amb_nits=$n; amb_slider=$s; amb_source=als
            echo "$n $s $now" > "$LIVE_FILE"
            model_sample "$n" "$now"
            return 0
        fi
    elif [ "$phase" != "off" ]; then
        echo "off $now" > "$PHASE_FILE"
        logline "built-in panel off (lid shut or display asleep), ambient from the model"
    fi

    # 4. the solar model, replaying this machine's own history for this elevation
    if [ -n "$amb_elev" ]; then
        local p; p=$(model_predict "$(model_bin "$amb_elev")" 2>/dev/null)
        if isnum "${p:-}"; then amb_nits=$p; amb_source=solar; return 0; fi
    fi

    # 5. the last trusted reading
    if [ -f "$LIVE_FILE" ]; then
        local ln="" ls="" le=""
        read -r ln ls le < "$LIVE_FILE" 2>/dev/null || true
        if isnum "${ln:-}"; then
            isnum "${le:-}" || le=$now
            amb_age=$(( now - le ))
            if [ "$HOLD_MAX_AGE" -gt 0 ] && [ "$amb_age" -gt "$HOLD_MAX_AGE" ]; then
                return 1
            fi
            amb_nits=$ln; amb_source=hold; return 0
        fi
    fi
    return 1
}

# Target luminance for one display, in DDC units, from the current ambient value.
target_lum() { # name ll lh
    local mx
    if [ "$MATCH" = "nits" ] || [ -z "$amb_slider" ]; then
        mx=$(max_nits "$1")
        if [ -n "$mx" ]; then
            awk -v n="$amb_nits" -v mx="$mx" -v lo="$2" -v hi="$3" 'BEGIN{
                v = 100 * n / mx
                if (v < lo) v = lo; if (v > hi) v = hi
                printf "%d", v + 0.5 }'
            return
        fi
    fi
    interp "$amb_slider" "$B_LO" "$B_HI" "$2" "$3"
}

# Blue gain follows where the luminance landed, not the raw ambient value.
target_blue() { # want_lum ll lh bl bh
    [ -z "$4" ] && return
    awk -v w="$1" -v lo="$2" -v hi="$3" -v bl="$4" -v bh="$5" 'BEGIN{
        t = (hi > lo ? (w - lo) / (hi - lo) : 1)
        if (t < 0) t = 0; if (t > 1) t = 1
        printf "%d", bl + t * (bh - bl) + 0.5 }'
}

parse() { # spec -> sets name ll lh bl bh mode
    local IFS=:
    read -r name ll lh bl bh mode <<< "$1"
    mode="${mode:-ddc}"
}

# Ramp in single DDC units - the hardware has no finer resolution.
# Deliberately linear: with one-unit steps, easing the acceleration would have to
# skip values in the middle of the move, reintroducing the stutter it removes.
#
# The target is recomputed every RAMP_CHUNK units of travel from a fresh ambient
# reading. Without that the agent drives to a target that went stale while it was
# moving, arrives, and only then notices - which reads as chasing, not tracking.
ramp() { # idx name cur_lum cur_blue ll lh bl bh
    local idx=$1 name=$2 cur=$3 curb=$4 ll=$5 lh=$6 bl=$7 bh=$8
    local budget=$(( RAMP_MAX_STEPS * 3 )) want wantb l x leg legb
    while [ "$budget" -gt 0 ]; do
        resolve_ambient || break
        want=$(target_lum "$name" "$ll" "$lh")
        wantb=$(target_blue "$want" "$ll" "$lh" "$bl" "$bh")
        if [ "$want" = "$cur" ] && { [ -z "$wantb" ] || [ "$wantb" = "$curb" ]; }; then break; fi

        # How far we are allowed to travel before re-checking ambient light.
        read -r leg legb < <(awk -v c="$cur" -v w="$want" -v cb="${curb:-0}" -v wb="${wantb:-0}" -v k="$RAMP_CHUNK" 'BEGIN{
            dl = w - c; adl = (dl < 0 ? -dl : dl)
            frac = (adl > k ? k / adl : 1)
            printf "%d %d\n", c + dl*frac + (dl < 0 ? -0.5 : 0.5), cb + (wb-cb)*frac + ((wb-cb) < 0 ? -0.5 : 0.5)
        }')

        while read -r l x; do
            if [ "$l" != "$cur" ]; then m1ddc display "$idx" set luminance "$l" >/dev/null 2>&1; cur=$l; fi
            if [ -n "$bl" ] && [ "$x" != "$curb" ]; then m1ddc display "$idx" set blue "$x" >/dev/null 2>&1; curb=$x; fi
            budget=$(( budget - 1 ))
        done < <(awk -v fl="$cur" -v tl="$leg" -v fb="${curb:-0}" -v tb="${legb:-0}" 'BEGIN{
            n = (tl > fl ? tl - fl : fl - tl); if (n < 1) n = 1
            for (i = 1; i <= n; i++) { t = i/n; printf "%d %d\n", fl+(tl-fl)*t+0.5, fb+(tb-fb)*t+0.5 }
        }')
    done
    RAMP_LUM=$cur; RAMP_BLUE=$curb
}

# Drive one monitor to target. Run in background so monitors move together.
apply_one() { # spec tick
    local spec="$1" tick="$2" name ll lh bl bh mode
    parse "$spec"
    [ "$mode" = "gamma" ] && return 0   # held by the resident daemon, not by this tick
    local st="$STATE_DIR/autobrightness.$(slug "$name").state"
    local want_lum want_blue=""
    want_lum=$(target_lum "$name" "$ll" "$lh")
    want_blue=$(target_blue "$want_lum" "$ll" "$lh" "$bl" "$bh")

    local c_lum="" c_blue=""
    [ -f "$st" ] && read -r c_lum c_blue < "$st" 2>/dev/null

    # fast path: target unchanged and not a resync tick -> no DDC traffic at all
    if [ -n "$c_lum" ] && [ $(( tick % RESYNC_EVERY )) -ne 0 ] \
       && [ "$(absdiff "$want_lum" "$c_lum")" -lt "$HYST_LUM" ] \
       && { [ -z "$want_blue" ] || [ "$(absdiff "$want_blue" "$c_blue")" -lt "$HYST_BLUE" ]; }; then
        return 0
    fi

    local idx; idx=$(find_display "$name"); [ -n "$idx" ] || return 0   # unplugged, wait quietly
    local cur_lum cur_blue=""
    cur_lum=$(m1ddc display "$idx" get luminance 2>/dev/null)
    cur_blue=""
    [ -n "$want_blue" ] && cur_blue=$(m1ddc display "$idx" get blue 2>/dev/null)
    # m1ddc prints its errors on stdout, so a failed read arrives here as a
    # sentence. Taken as a number it becomes zero and the ramp starts from the
    # wrong end of the scale; the cache is the better answer.
    isnum "${cur_lum:-}" || cur_lum="${c_lum:-$want_lum}"
    [ -n "$want_blue" ] && { isnum "${cur_blue:-}" || cur_blue="${c_blue:-$want_blue}"; }
    # A zero read on a DDC-capable panel means the I2C transaction collided with a
    # write in flight, not that the monitor sits at zero. Trust the cache instead.
    [ "$cur_lum" = "0" ] && [ -n "$c_lum" ] && [ "$c_lum" != "0" ] && cur_lum="$c_lum"
    [ "${cur_blue:-}" = "0" ] && [ -n "$c_blue" ] && [ "$c_blue" != "0" ] && cur_blue="$c_blue"

    local d_lum d_blue=0
    d_lum=$(absdiff "$want_lum" "$cur_lum")
    [ -n "$want_blue" ] && d_blue=$(absdiff "$want_blue" "$cur_blue")

    if [ "$d_lum" -ge "$HYST_LUM" ] || [ "$d_blue" -ge "$HYST_BLUE" ]; then
        logline "$name: $cur_lum/${cur_blue:--} -> $want_lum/${want_blue:--} ($amb_source ${amb_nits} nits, d=$d_lum/$d_blue)"
        if [ "$d_lum" -le "$RAMP_DIRECT" ] && [ "$d_blue" -le 2 ]; then
            [ "$d_lum"  -gt 0 ] && m1ddc display "$idx" set luminance "$want_lum" >/dev/null 2>&1
            [ "$d_blue" -gt 0 ] && m1ddc display "$idx" set blue "$want_blue" >/dev/null 2>&1
        else
            ramp "$idx" "$name" "$cur_lum" "$cur_blue" "$ll" "$lh" "$bl" "$bh"
            want_lum=$RAMP_LUM; want_blue=$RAMP_BLUE
        fi
        echo "$want_lum $want_blue" > "$st"
    else
        echo "$cur_lum $cur_blue" > "$st"
    fi
}

# uuid -> name, so the gamma daemon can resolve a display by its stable identity
# instead of an NSScreen list that goes stale the first time a display sleeps.
write_display_map() {
    m1ddc display list 2>/dev/null | awk '
        match($0, /^\[[0-9]+\] /) {
            rest = substr($0, RLENGTH + 1)
            if (match(rest, / \([0-9A-Fa-f-]+\)$/)) {
                printf "%s\t%s\n", substr(rest, RSTART + 2, RLENGTH - 3), substr(rest, 1, RSTART - 1)
            }
        }' > "$MAP_FILE.tmp" 2>/dev/null
    if [ -s "$MAP_FILE.tmp" ]; then
        cmp -s "$MAP_FILE.tmp" "$MAP_FILE" 2>/dev/null || mv "$MAP_FILE.tmp" "$MAP_FILE"
    fi
    rm -f "$MAP_FILE.tmp"
}

cmd="${1:-status}"
case "$cmd" in
  pause)   mkdir -p "$STATE_DIR"; touch "$PAUSE_FILE"; echo "paused"; exit 0 ;;
  resume)  rm -f "$PAUSE_FILE" "$STATE_DIR"/autobrightness.*.state; echo "resumed"; exit 0 ;;
  manual)
    mkdir -p "$STATE_DIR"
    case "${2:-}" in
      ""|show)
        if [ -f "$MANUAL_FILE" ]; then read -r mn _ < "$MANUAL_FILE"; echo "manual $mn nits"
        else echo "manual off"; fi ;;
      off|auto|clear) rm -f "$MANUAL_FILE"; echo "manual off" ;;
      *) isnum "$2" || die "usage: autobrightness manual <nits> | off"
         echo "$2 $(date +%s)" > "$MANUAL_FILE"; echo "manual $2 nits" ;;
    esac
    exit 0 ;;
  install)
    mkdir -p "$(dirname "$PLIST")"
    cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>local.autobrightness</string>
  <key>ProgramArguments</key><array>
    <string>$HOME/.local/bin/autobrightness</string><string>once</string></array>
  <key>StartInterval</key><integer>$INTERVAL</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>/tmp/autobrightness.err</string>
</dict></plist>
PLIST
    launchctl unload "$PLIST" 2>/dev/null
    launchctl load "$PLIST" && echo "agent installed, polling every ${INTERVAL}s"

    # Displays without DDC are dimmed through the gamma table, and macOS drops a
    # gamma table when the process that set it exits - so they need a resident
    # daemon rather than a periodic tick. It takes no readings of its own: the
    # tick above resolves ambient once and leaves it in a file.
    gspecs=()
    for spec in "${DISPLAYS[@]}"; do
        parse "$spec"
        [ "$mode" = "gamma" ] && gspecs+=("$name:$ll:$lh:$(max_nits "$name")")
    done
    launchctl unload "$GPLIST" 2>/dev/null
    rm -f "$GPLIST"
    if [ ${#gspecs[@]} -gt 0 ]; then
        [ -x "$SOFTDIM" ] || die "missing $SOFTDIM - run install.sh"
        for g in "${gspecs[@]}"; do
            case "$g" in *:) die "set a peak luminance for ${g%%:*} in DISPLAY_NITS";; esac
        done
        {
            echo '<?xml version="1.0" encoding="UTF-8"?>'
            echo '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
            echo '<plist version="1.0"><dict>'
            echo "  <key>Label</key><string>local.autobrightness-gamma</string>"
            echo "  <key>ProgramArguments</key><array>"
            echo "    <string>$SOFTDIM</string><string>daemon</string>"
            echo "    <string>$(( INTERVAL * 1000 ))</string><string>$PANEL_GAMMA</string>"
            for g in "${gspecs[@]}"; do echo "    <string>$g</string>"; done
            echo "  </array>"
            echo "  <key>KeepAlive</key><true/>"
            echo "  <key>RunAtLoad</key><true/>"
            echo "  <key>StandardErrorPath</key><string>/tmp/autobrightness-gamma.err</string>"
            echo "</dict></plist>"
        } > "$GPLIST"
        launchctl load "$GPLIST" && echo "gamma daemon installed for: ${gspecs[*]%%:*}"
    fi
    exit 0 ;;
  uninstall)
    launchctl unload "$PLIST" 2>/dev/null
    launchctl unload "$GPLIST" 2>/dev/null
    rm -f "$PLIST" "$GPLIST" "$STATE_DIR"/autobrightness.*.state
    echo "agent removed"; exit 0 ;;
esac

[ -x "$BB" ] || die "missing $BB - run install.sh"

case "$cmd" in
  status)
    resolve_ambient || true
    read -r mb mt < <(model_bins)
    printf 'ambient: %s nits from %s' "${amb_nits:-?}" "$amb_source"
    [ "$amb_age" -gt 0 ] && printf ' (%ss old)' "$amb_age"
    [ -n "$amb_slider" ] && printf ', slider %s' "$amb_slider"
    printf '\n'
    if solar_on; then
        printf 'sun: %s deg, model has %s of %s buckets\n' "$amb_elev" "$mb" "$mt"
    else
        printf 'sun: SOLAR_LAT/SOLAR_LON not set, the solar model is off\n'
    fi
    for spec in "${DISPLAYS[@]}"; do
        parse "$spec"
        if [ -z "$amb_nits" ]; then printf '  %-14s no ambient source\n' "$name"; continue; fi
        wl=$(target_lum "$name" "$ll" "$lh")
        if [ "$mode" = "gamma" ]; then
            printf '  %-14s target %3s     now %3s      (gamma, software dimming)\n' \
                "$name" "$wl" "$("$SOFTDIM" get "$name" 2>/dev/null || echo '?')"
            continue
        fi
        idx=$(find_display "$name")
        if [ -z "$idx" ]; then printf '  %-14s not connected\n' "$name"; continue; fi
        wb="-"; [ -n "$bl" ] && wb=$(target_blue "$wl" "$ll" "$lh" "$bl" "$bh")
        cl=$(m1ddc display "$idx" get luminance 2>/dev/null); isnum "$cl" || cl="?"
        cb="-"; [ -n "$bl" ] && { cb=$(m1ddc display "$idx" get blue 2>/dev/null); isnum "$cb" || cb="?"; }
        printf '  %-14s target %3s/%-3s  now %3s/%-3s\n' "$name" "$wl" "$wb" "$cl" "$cb"
    done
    [ -f "$MANUAL_FILE" ] && echo "state: MANUAL"
    [ -f "$PAUSE_FILE" ] && echo "state: PAUSED"
    exit 0 ;;

  ambient)
    resolve_ambient || true
    read -r mb mt < <(model_bins)
    printf 'nits     %s\nsource   %s\nage      %ss\nslider   %s\nsun      %s\nmodel    %s/%s buckets\n' \
        "${amb_nits:-none}" "$amb_source" "$amb_age" "${amb_slider:--}" "${amb_elev:--}" "$mb" "$mt"
    exit 0 ;;

  sun)
    # The elevation the solar model buckets by. Takes an epoch so the figure can
    # be checked against an almanac instead of only against the current sky.
    solar_on || die "set SOLAR_LAT and SOLAR_LON in $CONFIG"
    t="${2:-$(date +%s)}"
    isnum "$t" || die "usage: autobrightness sun [epoch]"
    printf '%s\n' "$(sun_elev "$t")"
    exit 0 ;;

  model)
    if [ ! -s "$MODEL_FILE" ]; then echo "the model has no samples yet"; exit 0; fi
    echo "sun elevation -> learned built-in luminance"
    sort -n "$MODEL_FILE" | awk -v w="$MODEL_BIN_DEG" -v now="$(date +%s)" '{
        printf "  %4d..%-4d deg  %7.1f nits  %4d samples  %s\n",
            $1 * w - 90, ($1 + 1) * w - 90, $2, $3,
            (now - $4 < 86400 ? "today" : sprintf("%dd ago", int((now - $4) / 86400)))
    }'
    exit 0 ;;

  --indicator)
    # Machine-readable snapshot for the menu bar app. Reads cached per-display
    # values rather than the bus: the agent refreshes that cache every second
    # tick, and the indicator must not add DDC traffic of its own.
    resolve_ambient || true
    read -r mb mt < <(model_bins)
    man_nits=""; man_json=null
    [ -f "$MANUAL_FILE" ] && read -r man_nits _ < "$MANUAL_FILE" 2>/dev/null
    isnum "${man_nits:-}" && man_json="{\"nits\":$man_nits}"
    paused=false; [ -f "$PAUSE_FILE" ] && paused=true
    printf '{"contract":%d,"paused":%s,"ambient":{"nits":%s,"source":"%s","age":%d,"slider":%s,"elevation":%s},' \
        "$CONTRACT" "$paused" "${amb_nits:-null}" "$amb_source" "$amb_age" \
        "${amb_slider:-null}" "${amb_elev:-null}"
    printf '"model":{"bins":%s,"bins_total":%s,"bin_deg":%s,"on":%s},' \
        "$mb" "$mt" "$MODEL_BIN_DEG" "$(solar_on && echo true || echo false)"
    printf '"manual":%s,"displays":[' "$man_json"
    first=1
    for spec in "${DISPLAYS[@]}"; do
        parse "$spec"
        st="$STATE_DIR/autobrightness.$(slug "$name").state"
        cl=null; cb=null; age=null
        if [ -f "$st" ]; then
            read -r f1 f2 < "$st" 2>/dev/null || true
            isnum "${f1:-}" && cl=$f1
            isnum "${f2:-}" && cb=$f2
            age=$(( $(date +%s) - $(stat -f %m "$st") ))
        fi
        # Connectivity comes from the display map the tick leaves behind, not from
        # m1ddc: the menu bar app polls this several times a minute and must not
        # put traffic on the bus to do it.
        conn=false
        [ -s "$MAP_FILE" ] && conn=$(awk -F'\t' -v n="$name" 'index($2, n) { f = 1 } END { print (f ? "true" : "false") }' "$MAP_FILE")
        if [ "$mode" = "gamma" ]; then
            g=$("$SOFTDIM" get "$name" 2>/dev/null)
            if isnum "${g:-}"; then cl=$g; else cl=null; fi
        fi
        wl=null; wb=null
        if [ -n "$amb_nits" ]; then
            wl=$(target_lum "$name" "$ll" "$lh")
            [ -n "$bl" ] && wb=$(target_blue "$wl" "$ll" "$lh" "$bl" "$bh")
        fi
        [ "$first" = 1 ] || printf ','
        first=0
        printf '{"name":"%s","mode":"%s","connected":%s,"target_lum":%s,"target_blue":%s,"lum":%s,"blue":%s,"age":%s}' \
            "$name" "$mode" "$conn" "${wl:-null}" "${wb:-null}" "$cl" "$cb" "$age"
    done
    printf ']}\n'
    exit 0 ;;

  curve)
    resolve_ambient || true
    for spec in "${DISPLAYS[@]}"; do
        parse "$spec"
        mx=$(max_nits "$name")
        echo "$name  (built-in luminance -> luminance/blue)"
        for x in 1 2 5 10 20 50 100 150 200 300 400; do
            amb_nits=$x amb_slider=""
            wl=$(target_lum "$name" "$ll" "$lh")
            wb="-"; [ -n "$bl" ] && wb=$(target_blue "$wl" "$ll" "$lh" "$bl" "$bh")
            printf '  %4s nits -> %3s / %-3s\n' "$x" "$wl" "$wb"
        done
    done
    exit 0 ;;

  once)
    mkdir -p "$STATE_DIR"
    # Detect System Settings opening on its own. Runs every tick, including idle ones.
    now_open=$(pgrep -f 'System Settings' >/dev/null 2>&1 && echo 1 || echo 0)
    was_open=0; [ -f "$SEEN_FILE" ] && was_open=$(cat "$SEEN_FILE" 2>/dev/null || echo 0)
    if [ "$now_open" != "$was_open" ]; then
        [ "$now_open" = 1 ] && logline "SYSTEM SETTINGS OPENED" || logline "system settings closed"
        echo "$now_open" > "$SEEN_FILE"
    fi
    [ -f "$PAUSE_FILE" ] && exit 0

    write_display_map
    if ! resolve_ambient; then
        # Nothing can say what the room is like - first run with the lid already
        # shut, say. Leave the monitors alone rather than guess.
        rm -f "$AMBIENT_FILE"
        exit 0
    fi
    echo "$amb_nits $amb_source $(date +%s)" > "$AMBIENT_FILE"

    tick=0; [ -f "$TICK_FILE" ] && tick=$(cat "$TICK_FILE" 2>/dev/null || echo 0)
    isnum "$tick" || tick=0
    tick=$(( tick + 1 )); echo "$tick" > "$TICK_FILE"

    for spec in "${DISPLAYS[@]}"; do apply_one "$spec" "$tick" & done
    wait
    exit 0 ;;

  *) echo "autobrightness status | ambient | sun [epoch] | model | curve | once | manual <nits>|off | pause | resume | install | uninstall"; exit 2 ;;
esac
